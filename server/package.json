{
  "name": "greenwise-server",
  "version": "1.0.0",
  "description": "Backend server for GreenWise e-commerce platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "stable": "node keepAlive.js",
    "pm2": "pm2 start server.js --name greenwise-server",
    "pm2:stop": "pm2 stop greenwise-server",
    "pm2:restart": "pm2 restart greenwise-server",
    "pm2:logs": "pm2 logs greenwise-server"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.3",
    "nodemon": "^2.0.22"
  },
  "keywords": [
    "ecommerce",
    "sustainability",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "GreenWise Team",
  "license": "MIT"
}
